DATABASE_URL="file:./prisma/dev.db"

# Login session. Set AUTH_SECURE_COOKIE=true only when the site is behind HTTPS.
AUTH_SESSION_TTL_DAYS="14"
AUTH_SECURE_COOKIE="false"
# Optional: existing account used by everyone. Empty uses the first-created account.
SHARED_LOGIN_EMAIL=""
# Optional verified fee table JSON; see README. No guessed Amazon rates by default.
STORE_OPS_PROFIT_FEE_RULES="[]"
# Source links only; these do not enable scheduled downloads or grant WPS access.
STORE_OPS_WPS_INVENTORY_URL=""
STORE_OPS_WPS_RESEARCH_URL=""

# GERPgo: server-side credentials only. Do not commit a filled environment file.
GERPGO_APP_ID=""
GERPGO_APP_KEY=""
GERPGO_BASE_URL="https://open.gerpgo.com/api/open"
GERPGO_SIGNING_ENABLED="true"
GERPGO_TIMEOUT_MS="10000"
# Existing NAS encryption secret. Keep stable and outside Git (32+ characters).
SECRET_KEY=""

# Jungle Scout
JS_USE_MOCK=""
JS_API_BASE_URL="https://developer.junglescout.com/api"
JS_API_TYPE="junglescout"
JS_MARKETPLACE="us"
JS_API_KEY_NAME=""
JS_API_KEY=""
JS_ENDPOINT_KEYWORDS_BY_KEYWORD="/keywords/keywords_by_keyword_query"
JS_RESOURCE_TYPE_KEYWORDS_BY_KEYWORD="keywords_by_keyword_query"
JS_ENDPOINT_PRODUCT_DATABASE="/product_database_query"
JS_RESOURCE_TYPE_PRODUCT_DATABASE="product_database_query"
JS_ENDPOINT_KEYWORDS_BY_ASIN="/keywords/keywords_by_asin_query"
JS_RESOURCE_TYPE_KEYWORDS_BY_ASIN="keywords_by_asin_query"
JS_ENDPOINT_HISTORICAL_SEARCH_VOLUME="/keywords/historical_search_volume"
JS_ENDPOINT_SALES_ESTIMATES="/sales_estimates_query"
JS_ENDPOINT_SHARE_OF_VOICE="/share_of_voice"

# You can also place Jungle Scout credentials in ./api.txt.
# Official auth format is KEY_NAME:API_KEY.
# If api.txt only stores the API key, also fill JS_API_KEY_NAME.

# Optional Amazon SP-API placeholders
AMZ_LWA_CLIENT_ID=""
AMZ_LWA_CLIENT_SECRET=""
AMZ_REFRESH_TOKEN=""
AMZ_AWS_ACCESS_KEY_ID=""
AMZ_AWS_SECRET_ACCESS_KEY=""
AMZ_AWS_ROLE_ARN=""
AMZ_MARKETPLACE_ID=""

# LLM adapter
LLM_PROVIDER="disabled"
LLM_API_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_MODEL=""
LLM_TIMEOUT_MS="30000"
