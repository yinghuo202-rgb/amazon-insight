generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SeedSearch {
  id                String             @id @default(cuid())
  keyword           String
  normalizedKeyword String
  marketplace       String             @default("us")
  sourceMode        String             @default("mock")
  createdAt         DateTime           @default(now())
  candidateKeywords CandidateKeyword[]
  candidateProducts CandidateProduct[]
  analyses          ProductAnalysis[]

  @@index([normalizedKeyword, createdAt])
}

model CandidateKeyword {
  id           String     @id @default(cuid())
  searchId     String
  search       SeedSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  keyword      String
  searchVolume Int?
  trend        String?
  difficulty   String?
  relevance    Float?
  cpc          Float?
  rawJson      String?
  createdAt    DateTime   @default(now())

  @@index([searchId])
}

model CandidateProduct {
  id             String     @id @default(cuid())
  searchId       String
  search         SeedSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  asin           String
  title          String
  brand          String?
  imageUrl       String?
  price          Float?
  rating         Float?
  reviews        Int?
  category       String?
  monthlyUnits   Int?
  monthlyRevenue Float?
  sourceKeyword  String?
  relevanceHint  String?
  rawJson        String?
  createdAt      DateTime   @default(now())

  @@unique([searchId, asin])
  @@index([asin])
  @@index([searchId])
}

model ProductAnalysis {
  id                  String               @id @default(cuid())
  asin                String
  searchId            String
  search              SeedSearch           @relation(fields: [searchId], references: [id], onDelete: Cascade)
  primaryKeyword      String
  compareAsinsJson    String?
  lifecycleStage      String
  lifecycleConfidence String
  competitionLevel    String
  opportunityLevel    String
  summary             String
  recommendation      String
  responseJson        String
  contextJson         String?
  rawMetricsJson      String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  inspirations        ProductInspiration[]

  @@index([asin])
  @@index([searchId])
  @@index([createdAt])
}

model ProductInspiration {
  id                       String          @id @default(cuid())
  asin                     String
  analysisId               String
  analysis                 ProductAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  audience                 String?
  purchaseDriversJson      String
  valuePropsJson           String
  painPointsJson           String
  differentiationIdeasJson String
  listingAnglesJson        String
  visualAnglesJson         String
  generationMetaJson       String
  manualInputsJson         String?
  responseJson             String
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@index([analysisId])
  @@index([asin])
}

model ProductPoolItem {
  id             String   @id @default(cuid())
  asin           String   @unique
  title          String
  brand          String?
  imageUrl       String?
  price          Float?
  rating         Float?
  reviews        Int?
  category       String?
  monthlyUnits   Int?
  monthlyRevenue Float?
  sourceKeyword  String?
  relevanceHint  String?
  sourceSearchId String?
  sourceMode     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([updatedAt])
}

model ApiCache {
  id        String   @id @default(cuid())
  namespace String
  key       String
  value     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([namespace, key])
  @@index([expiresAt])
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  name          String
  passwordHash  String
  role          String              @default("MEMBER")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  sessions      Session[]
  memberships   WorkspaceMember[]
  createdTasks  CollaborationTask[] @relation("TaskCreatedBy")
  assignedTasks CollaborationTask[] @relation("TaskAssignee")
  updatedTasks  CollaborationTask[] @relation("TaskUpdatedBy")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Workspace {
  id        String            @id @default(cuid())
  name      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   WorkspaceMember[]
  tasks     CollaborationTask[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("MEMBER")
  joinedAt    DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model CollaborationTask {
  id          String    @id @default(cuid())
  workspaceId String
  sku         String
  title       String
  note        String?
  status      String    @default("OPEN")
  assigneeId  String?
  createdById String
  updatedById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User      @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User      @relation("TaskUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([workspaceId, status])
  @@index([workspaceId, sku])
  @@index([assigneeId])
}

model IntegrationConfig {
  id              String   @id @default(cuid())
  provider        String   @unique
  configJson      String   @default("{}")
  encryptedSecret String?
  updatedAt       DateTime @updatedAt
}

model ErpStore {
  id              String   @id @default(cuid())
  storeId         String   @unique
  provider        String   @default("gerpgo")
  name            String
  marketplaceCode String
  countryCode     String?
  currency        String?
  enabled         Boolean  @default(true)
  selected        Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  @@index([provider, selected])
}

model ErpDailySales {
  id                  String   @id @default(cuid())
  businessDate        String
  storeId             String
  marketplaceCode     String
  currency            String
  originalAmountMinor Int
  baseCurrency        String
  baseAmountMinor     Int
  source              String   @default("gerpgo")
  fetchedAt           DateTime @default(now())

  @@unique([businessDate, storeId, baseCurrency])
  @@index([businessDate])
}

model ErpEvent {
  id              String   @id @default(cuid())
  eventId         String   @unique
  type            String
  storeId         String?
  orderId         String?
  marketplace     String
  msku            String
  asin            String?
  quantity        Int      @default(1)
  amountMinor     Int      @default(0)
  currency        String?
  baseAmountMinor Int      @default(0)
  salesDeltaMinor Int      @default(0)
  rating          Int?
  content         String?
  status          String?
  occurredAt      DateTime
  createdAt       DateTime @default(now())

  @@index([occurredAt])
  @@index([type, occurredAt])
}

model ErpSyncCursor {
  id        String   @id @default(cuid())
  stream    String   @unique
  cursor    String
  updatedAt DateTime @updatedAt
}

model AmazonCrawlSnapshot {
  id              String   @id @default(cuid())
  asin            String
  marketplace     String   @default("US")
  title           String
  brand           String?
  price           Float?
  currency        String   @default("USD")
  rating          Float?
  reviews         Int?
  bsrRank         Int?
  bsrCategory     String?
  monthlySalesEst Int?
  sellerCount     Int?
  imageUrl        String?
  bulletsJson     String?
  rawJson         String?
  source          String   @default("crawler")
  crawledAt       DateTime @default(now())

  @@index([asin, crawledAt])
  @@index([marketplace, crawledAt])
}

model Supplier1688Quote {
  id               String   @id @default(cuid())
  offerId          String   @unique
  title            String
  supplierName     String?
  supplierLocation String?
  unitPriceRmb     Float
  moq              Int?
  leadTimeDays     Int?
  weightG          Float?
  dimensionsCm     String?
  linkedAsin       String?
  linkedSku        String?
  offerUrl         String?
  imageUrl         String?
  specsJson        String?
  rawJson          String?
  crawledAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([linkedAsin])
  @@index([linkedSku])
}

model CrawlJob {
  id          String    @id @default(cuid())
  target      String
  action      String    @default("product")
  marketplace String    @default("US")
  query       String
  linkedAsin  String?
  linkedSku   String?
  syncToPool  Boolean   @default(false)
  payloadJson String?
  status      String    @default("PENDING")
  priority    Int       @default(0)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  scheduledAt DateTime  @default(now())
  lockedBy    String?
  lockedAt    DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  resultJson  String?
  lastError   String?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, scheduledAt, priority])
  @@index([target, status])
  @@index([createdAt])
}

model WorkerState {
  id              String    @id @default(cuid())
  workerId        String    @unique
  status          String    @default("IDLE")
  lastHeartbeatAt DateTime  @default(now())
  lastErpSyncAt   DateTime?
  lastErpError    String?
  lastCrawlJobId  String?
  lastCrawlAt     DateTime?
  metaJson        String?
  updatedAt       DateTime  @updatedAt
}

