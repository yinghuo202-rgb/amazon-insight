generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SeedSearch {
  id                String             @id @default(cuid())
  keyword           String
  normalizedKeyword String
  marketplace       String             @default("us")
  sourceMode        String             @default("mock")
  createdAt         DateTime           @default(now())
  candidateKeywords CandidateKeyword[]
  candidateProducts CandidateProduct[]
  analyses          ProductAnalysis[]

  @@index([normalizedKeyword, createdAt])
}

model CandidateKeyword {
  id           String     @id @default(cuid())
  searchId     String
  search       SeedSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  keyword      String
  searchVolume Int?
  trend        String?
  difficulty   String?
  relevance    Float?
  cpc          Float?
  rawJson      String?
  createdAt    DateTime   @default(now())

  @@index([searchId])
}

model CandidateProduct {
  id             String     @id @default(cuid())
  searchId       String
  search         SeedSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  asin           String
  title          String
  brand          String?
  imageUrl       String?
  price          Float?
  rating         Float?
  reviews        Int?
  category       String?
  monthlyUnits   Int?
  monthlyRevenue Float?
  sourceKeyword  String?
  relevanceHint  String?
  rawJson        String?
  createdAt      DateTime   @default(now())

  @@unique([searchId, asin])
  @@index([asin])
  @@index([searchId])
}

model ProductAnalysis {
  id                  String               @id @default(cuid())
  asin                String
  searchId            String
  search              SeedSearch           @relation(fields: [searchId], references: [id], onDelete: Cascade)
  primaryKeyword      String
  compareAsinsJson    String?
  lifecycleStage      String
  lifecycleConfidence String
  competitionLevel    String
  opportunityLevel    String
  summary             String
  recommendation      String
  responseJson        String
  contextJson         String?
  rawMetricsJson      String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  inspirations        ProductInspiration[]

  @@index([asin])
  @@index([searchId])
  @@index([createdAt])
}

model ProductInspiration {
  id                       String          @id @default(cuid())
  asin                     String
  analysisId               String
  analysis                 ProductAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  audience                 String?
  purchaseDriversJson      String
  valuePropsJson           String
  painPointsJson           String
  differentiationIdeasJson String
  listingAnglesJson        String
  visualAnglesJson         String
  generationMetaJson       String
  manualInputsJson         String?
  responseJson             String
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@index([analysisId])
  @@index([asin])
}

model ProductPoolItem {
  id             String   @id @default(cuid())
  asin           String   @unique
  title          String
  brand          String?
  imageUrl       String?
  price          Float?
  rating         Float?
  reviews        Int?
  category       String?
  monthlyUnits   Int?
  monthlyRevenue Float?
  sourceKeyword  String?
  relevanceHint  String?
  sourceSearchId String?
  sourceMode     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([category])
  @@index([updatedAt])
}

model ApiCache {
  id        String   @id @default(cuid())
  namespace String
  key       String
  value     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([namespace, key])
  @@index([expiresAt])
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  name          String
  passwordHash  String
  role          String              @default("MEMBER")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  sessions      Session[]
  memberships   WorkspaceMember[]
  createdTasks  CollaborationTask[] @relation("TaskCreatedBy")
  assignedTasks CollaborationTask[] @relation("TaskAssignee")
  updatedTasks  CollaborationTask[] @relation("TaskUpdatedBy")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Workspace {
  id        String            @id @default(cuid())
  name      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   WorkspaceMember[]
  tasks     CollaborationTask[]
  warehouses Warehouse[]
  stockDocuments StockDocument[]
}

model Warehouse {
  id             String                @id @default(cuid())
  workspaceId    String
  code           String
  name           String
  kind           String                @default("DOMESTIC")
  active         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  locations      WarehouseLocation[]
  products       WarehouseProduct[]
  documents      StockDocument[]        @relation("DocumentWarehouse")
  transferTargets StockDocument[]       @relation("DocumentTargetWarehouse")
  lots           InventoryLot[]
  movements      StockMovement[]

  @@unique([workspaceId, code])
  @@index([workspaceId, active])
}

model WarehouseLocation {
  id          String    @id @default(cuid())
  warehouseId String
  code        String
  name        String
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  lots        InventoryLot[]
  movements   StockMovement[]
  documentLines StockDocumentLine[]

  @@unique([warehouseId, code])
  @@index([warehouseId, active])
}

model WarehouseProduct {
  id          String    @id @default(cuid())
  warehouseId String
  productCode String
  sku         String
  barcode     String?
  name        String
  unit        String    @default("件")
  cartonQty   Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productCode])
  @@index([warehouseId, sku])
  @@index([barcode])
}

model StockDocument {
  id                String             @id @default(cuid())
  workspaceId       String
  documentNo        String
  type              String
  status            String             @default("DRAFT")
  warehouseId       String
  targetWarehouseId String?
  supplier          String?
  reference          String?
  note               String?
  createdById        String
  approvedById       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  approvedAt         DateTime?
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  warehouse          Warehouse          @relation("DocumentWarehouse", fields: [warehouseId], references: [id], onDelete: Restrict)
  targetWarehouse    Warehouse?         @relation("DocumentTargetWarehouse", fields: [targetWarehouseId], references: [id], onDelete: Restrict)
  lines              StockDocumentLine[]
  movements          StockMovement[]

  @@unique([workspaceId, documentNo])
  @@index([workspaceId, type, status, createdAt])
  @@index([warehouseId, createdAt])
}

model StockDocumentLine {
  id           String    @id @default(cuid())
  documentId   String
  sku          String
  productCode  String?
  lotCode      String?
  poNumber     String?
  locationId   String?
  quantity     Int
  direction    String    @default("IN")
  unitCost     Float?
  createdAt    DateTime  @default(now())
  document     StockDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  location     WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  movements    StockMovement[]
  allocations  OutboundAllocation[]

  @@index([documentId, sku])
  @@index([sku, lotCode])
}

model InventoryLot {
  id              String      @id @default(cuid())
  warehouseId     String
  sku             String
  lotCode         String
  poNumber        String?
  sourceDocumentId String?
  locationId      String?
  receivedAt      DateTime
  unitCost        Float?
  receivedQty     Int
  remainingQty    Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  warehouse       Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  location        WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  allocations     OutboundAllocation[]
  movements       StockMovement[]

  @@unique([warehouseId, sku, lotCode])
  @@index([warehouseId, sku, receivedAt])
  @@index([poNumber])
}

model OutboundAllocation {
  id         String           @id @default(cuid())
  lineId     String
  lotId      String
  quantity   Int
  method     String           @default("FIFO")
  createdAt  DateTime         @default(now())
  line       StockDocumentLine @relation(fields: [lineId], references: [id], onDelete: Restrict)
  lot        InventoryLot     @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@unique([lineId, lotId])
  @@index([lotId, createdAt])
}

model StockMovement {
  id           String            @id @default(cuid())
  workspaceId  String
  documentId   String
  lineId       String
  warehouseId  String
  lotId        String?
  locationId   String?
  sku          String
  quantity     Int
  unitCost     Float?
  movementType String
  actorId      String
  createdAt    DateTime          @default(now())
  document     StockDocument     @relation(fields: [documentId], references: [id], onDelete: Restrict)
  line         StockDocumentLine @relation(fields: [lineId], references: [id], onDelete: Restrict)
  warehouse    Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lot          InventoryLot?     @relation(fields: [lotId], references: [id], onDelete: Restrict)
  location     WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([workspaceId, sku, createdAt])
  @@index([warehouseId, sku, createdAt])
  @@index([documentId])
}

model WarehouseAuditEvent {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String
  entityType  String
  entityId    String
  action      String
  detailJson  String
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("MEMBER")
  joinedAt    DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model CollaborationTask {
  id          String    @id @default(cuid())
  workspaceId String
  sku         String
  title       String
  note        String?
  status      String    @default("OPEN")
  assigneeId  String?
  createdById String
  updatedById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User      @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy   User      @relation("TaskUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)

  @@index([workspaceId, status])
  @@index([workspaceId, sku])
  @@index([assigneeId])
}
