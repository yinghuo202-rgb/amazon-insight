APP_PORT=3001
APP_ENV=production
IMAGE_REPOSITORY=ghcr.io/yinghuo202-rgb/amazon-insight
IMAGE_TAG=v1.0.0
DATABASE_URL=file:/data/app/selection.db
PUBLIC_APP_URL=http://localhost:3001
SECRET_KEY=replace-with-a-long-random-value
AUTH_SESSION_TTL_DAYS=14
AUTH_SECURE_COOKIE=false
DATABASE_MIGRATE_ON_START=true

# NAS host directories. Keep these outside the container lifecycle.
DATA_PATH=./data/app
RUNTIME_PATH=./data/runtime
SOURCE_DATA_PATH=./data/sources
LOG_PATH=./logs

# Optional external integrations.
API_KEY=
LLM_PROVIDER=disabled
LLM_API_KEY=

# Optional Watchtower profile.
WATCHTOWER_INTERVAL=300
DOCKER_CONFIG_FILE=./.docker/config.json

# Optional Cloudflare Tunnel profile. Keep the token outside GitHub.
CLOUDFLARE_IMAGE=cloudflare/cloudflared:latest
CLOUDFLARE_TUNNEL_TOKEN_FILE=./secrets/cloudflare-token.txt
