APP_PORT=3000
APP_ENV=production
IMAGE_REPOSITORY=ghcr.io/yinghuo202-rgb/amazon-insight
IMAGE_TAG=latest
DATABASE_URL=file:/data/app/selection.db
PUBLIC_APP_URL=http://localhost:3000
SECRET_KEY=replace-with-a-long-random-value
AUTH_SESSION_TTL_DAYS=14
AUTH_SECURE_COOKIE=false
DATABASE_MIGRATE_ON_START=true

# NAS host directories. Keep these outside the container lifecycle.
DATA_PATH=./data/app
RUNTIME_PATH=./data/runtime
SOURCE_DATA_PATH=./data/sources
LOG_PATH=./logs

# Optional Jungle Scout & LLM integrations.
JS_API_KEY_NAME=
JS_API_KEY=
LLM_PROVIDER=disabled
LLM_API_KEY=
LLM_MODEL=
LLM_API_BASE_URL=https://api.openai.com/v1

# Optional GerpGo (积加 ERP) OpenAPI integration.
GERPGO_APP_ID=
GERPGO_APP_KEY=
GERPGO_BASE_URL=https://open.gerpgo.com/api/open

# Optional bearer token for Amazon / 1688 crawler ingestion APIs.
CRAWLER_INGEST_TOKEN=

# Optional background worker settings (reuses the same Docker image).
WORKER_ID=nas-worker
WORKER_AUTH_TOKEN=
WORKER_POLL_INTERVAL_SEC=10
WORKER_ERP_SYNC_INTERVAL_SEC=60
WORKER_HEARTBEAT_INTERVAL_SEC=30
CRAWLER_AMAZON_WEBHOOK_URL=
CRAWLER_1688_WEBHOOK_URL=
CRAWLER_WEBHOOK_TOKEN=
CRAWLER_AMAZON_CMD=
CRAWLER_1688_CMD=

# Optional Watchtower profile.
WATCHTOWER_INTERVAL=300
DOCKER_CONFIG_FILE=./.docker/config.json
